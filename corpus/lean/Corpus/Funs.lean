/-- [corpus::paper::list_nth_mut]:
    Source: 'src/paper.rs', lines 43:0-56:1
    Visibility: public -/
def paper.list_nth_mut
  {T : Type} (l : paper.List T) (i : Std.U32) :
  Result (T × (T → paper.List T))
  := do
  match l with
  | paper.List.Cons x tl =>
    if i = 0#u32
    then let back := fun t => paper.List.Cons t tl
         ok (x, back)
    else
      let i1 ← i - 1#u32
      let (x1, list_nth_mut_back) ← paper.list_nth_mut tl i1
      let back := fun t => let tl1 := list_nth_mut_back t
                           paper.List.Cons x tl1
      ok (x1, back)
  | paper.List.Nil => fail panic
partial_fixpoint

