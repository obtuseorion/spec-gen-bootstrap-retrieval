/-- [corpus::glue::fanout::hub]:
    Source: 'src/glue/fanout.rs', lines 9:0-26:1
    Visibility: public -/
def glue.fanout.hub (x : Std.U32) : Result Std.U32 := do
  let small ← x % 8#u32
  let a ← bitwise.shift_u32 small
  let b ← bitwise.xor_u32 a small
  let c ← bitwise.or_u32 b 1#u32
  let d ← bitwise.and_u32 c 255#u32
  let e ← tutorial.mul2_add1 d
  let f ← tutorial.mul2_add1_add e small
  let g ← no_nested_borrows.get_max f e
  let h ← loops.sum small
  let i ← loops.iter small
  let acc ← no_nested_borrows.cast_u32_to_i32 small
  let acc1 ← paper.ref_incr acc
  let j ← no_nested_borrows.copy_int acc1
  let b1 ← tutorial.even small
  let parity ← if b1
                 then ok 1#u32
                 else ok 0#u32
  let b2 ← tutorial.odd small
  let parity2 ← if b2
                  then ok 1#u32
                  else ok 0#u32
  let i1 ← g + h
  let i2 ← i1 + i
  let i3 ← lift (IScalar.hcast .U32 j)
  let i4 ← i2 + i3
  let i5 ← i4 + parity
  i5 + parity2

